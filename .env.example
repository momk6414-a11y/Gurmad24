# GURMAD 24 - environment configuration example.
# Copy this file to ".env" and edit. NEVER commit ".env" or share it.

# Port the server listens on (hosting platforms usually set this for you)
PORT=8080

# Folder where the database, backups and the session secret are stored.
# On a host, point this to a PERSISTENT DISK (e.g. /var/data).
DATA_DIR=./data

# Secret used to protect sessions. If empty, a random one is generated and saved in DATA_DIR/.secret
SESSION_SECRET=

# First administrator. If ADMIN_PASSWORD is empty on first start, a random password is
# generated and printed ONCE in the server log (and saved in DATA_DIR/FIRST_ADMIN.txt).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# DEMO_MODE=true  -> sandbox payments only, every screen shows DEMO labels. Keep true until
#                    legal/payment/medical approvals exist. Setting false does NOT enable real
#                    payments: no real payment provider is connected in this code.
DEMO_MODE=true

# Seed synthetic (fake) hospitals, cards and providers on first start.
SEED_DEMO_DATA=true

# Optional: create demo login accounts (one per role) with THIS password (min 10 chars).
# Leave empty for production.
DEMO_PASSWORD=

# Set true ONLY when DATA_DIR is on a persistent disk. On Render this is false by default
# (free plan wipes data on every restart/deploy); the admin dashboard shows a warning until it is true.
PERSISTENT_STORAGE=

# Set true when served over HTTPS (all hosting platforms) so cookies are "Secure".
COOKIE_SECURE=false
# Set true when running behind a proxy/load balancer (Render, Railway, Fly, Nginx).
TRUST_PROXY=false

# Days after which closed emergency-case records are anonymised (data retention).
RETENTION_DAYS=365
